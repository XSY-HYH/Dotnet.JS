<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Dotnet.JS</RootNamespace>
    <AssemblyName>Dotnet.JS</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Esprima" Version="3.0.6" />
    <PackageReference Include="Jint" Version="4.15.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="lib\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyLibToPublish" AfterTargets="Publish">
    <ItemGroup>
      <LibFiles Include="$(MSBuildProjectDirectory)\lib\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(LibFiles)" DestinationFolder="$(PublishDir)\lib\%(RecursiveDir)" />
  </Target>

</Project>
